{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:pg-native --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\" --outfile=dist/index.js && rm -rf dist/drizzle && cp -r drizzle dist/",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "test": "node --import tsx --test --test-concurrency=1 --test-timeout=60000 test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dom-serializer": "^2.0.0",
    "domhandler": "^5.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^10.1.0",
    "imapflow": "^2.10.0",
    "libmime": "^5.6.3",
    "libqp": "^3.0.1",
    "mailparser": "^3.14.1",
    "nodemailer": "^10.3.1",
    "oidc-provider": "9.13.3",
    "pg": "^8.23.1",
    "socks": "2.8.10",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/oidc-provider": "9.13.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
