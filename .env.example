# 开发：pnpm dev 会读取根目录 .env
DATABASE_URL=postgres://damail:damail@127.0.0.1:55434/damail
PORT=8787
# 开发时只监听本机；Docker 内需要 0.0.0.0（默认值）
HOST=127.0.0.1

# 生产（docker compose）必填：openssl rand -hex 32
MASTER_KEY=
POSTGRES_PASSWORD=change-me
PUBLIC_URL=https://mail.example.com
# 通过 HTTPS 反向代理访问时设为 true
COOKIE_SECURE=false
# 默认轮询间隔（秒），每个邮箱可以在「邮箱管理」里单独设置；INBOX 走 IDLE 实时推送，按此间隔兜底
POLL_INTERVAL_SEC=300
# 单封邮件超过该大小只同步前 2MB
MAX_MESSAGE_MB=30
# 点击发送后延迟多少秒才真正发出（期间可撤销）
SEND_DELAY_SEC=10
# 单封邮件附件总大小上限（MB）
MAX_ATTACHMENT_MB=25
# 通知渠道默认不能推送到内网地址；Webhook 指向局域网内的服务（如自建 n8n）时设为 true
ALLOW_PRIVATE_WEBHOOKS=false

# ---- MCP OAuth（ChatGPT 等客户端登录授权接入 /mcp，详见 docs/mcp-oauth.md）----
# 与「接入邮箱」的 Gmail / Microsoft OAuth 无关，那条链路不受这些变量影响
# 开关、客户端、回调地址、代理、发信上限、提示方式推荐在网页「开放接口 → OAuth 设置」里设置（立即生效）；
# 网页上保存过之后，下面对应的变量不再生效。网页上从没保存过时才使用它们
MCP_OAUTH_ENABLED=false
# 授权服务器和 MCP 资源地址，默认分别为 PUBLIC_URL 和 PUBLIC_URL/mcp；非本机必须 HTTPS
# MCP_OAUTH_ISSUER=https://mail.example.com
# MCP_OAUTH_RESOURCE=https://mail.example.com/mcp
# 允许的 CIMD client_id（客户端元数据文档 URL），逗号分隔，按 ChatGPT 连接管理页显示的值精确填写，不支持通配符
MCP_OAUTH_CIMD_CLIENTS=
# 允许的回调地址，逗号分隔，精确匹配，按 ChatGPT 连接管理页显示的值填写
MCP_OAUTH_REDIRECT_URIS=
# 服务器直连不了客户端（如国内服务器访问 chatgpt.com）时，CIMD 文档和客户端公钥经「代理设置」里的哪个代理抓取（填代理 id）；
# 经代理时只允许访问 MCP_OAUTH_CIMD_CLIENTS 所在的源，超时默认 8 秒
# MCP_OAUTH_FETCH_PROXY_ID=
# MCP_OAUTH_FETCH_TIMEOUT_MS=8000
# 预注册客户端（不走 CIMD 时使用），JSON 数组：[{"client_id":"...","client_name":"...","redirect_uris":["https://..."]}]
MCP_OAUTH_STATIC_CLIENTS=
# 有效期（秒）：授权码 5 分钟、access token 15 分钟、refresh token 30 天、授权 365 天
# MCP_OAUTH_CODE_TTL_SEC=300
# MCP_OAUTH_ACCESS_TOKEN_TTL_SEC=900
# MCP_OAUTH_REFRESH_TOKEN_TTL_SEC=2592000
# MCP_OAUTH_GRANT_TTL_SEC=31536000
# 每个授权每小时最多直接发送多少封（mail:send），0 = 禁止直接发送
MCP_OAUTH_SEND_LIMIT_PER_HOUR=10
# /oauth/authorize、/oauth/token、/oauth/revoke 每个 IP 每分钟请求上限
MCP_OAUTH_RATE_LIMIT_PER_MIN=60
# 权限不足时的提示方式：http（HTTP 403 + WWW-Authenticate，默认）或 tool（工具返回错误 + _meta["mcp/www_authenticate"]）
MCP_OAUTH_SCOPE_CHALLENGE=http

# ---- 检查新版本 ----
# 服务端每 6 小时读一次 GitHub 上最新的正式 Release，网页上提示「有新版本」；内网或不想访问 GitHub 时设为 false
UPDATE_CHECK=true
# 读哪个仓库的 Release（owner/repo）
# UPDATE_REPO=gopkg-dev/damail
# 服务器直连不了 api.github.com 时，经「代理设置」里的哪个代理（填代理 id）
# UPDATE_CHECK_PROXY_ID=
# docker-compose.yml 使用的镜像版本，默认 latest
# DAMAIL_VERSION=v0.2.0
