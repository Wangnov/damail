---
import logo from '../assets/logo.svg?raw';
import { HOME } from '../i18n/home';
import Icon, { type IconName } from './Icon.astro';
import '../styles/home.css';

interface Props {
  locale: 'zh' | 'en';
}
const { locale } = Astro.props;
const t = HOME[locale];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const prefix = locale === 'en' ? `${base}en/` : base;
const REPO = 'https://github.com/gopkg-dev/damail';
const docs = (path = '') => `${prefix}docs/${path}`;
const chat = t.assistant.chat;
const subs = t.subs.mock;

const FEATURE_ICONS: IconName[] = ['sync', 'sparkles', 'rule', 'bell', 'chart', 'search', 'pen', 'globe'];
const ASSIST_ICONS: IconName[] = ['search', 'mail', 'reply', 'check', 'cpu'];
const SUBS_ICONS: IconName[] = ['chart', 'shield', 'mail', 'bot'];
const AGENT_ICONS: IconName[] = ['key', 'layers', 'check', 'shield'];
// 首页「可以接入」列表：前四个是主动型 AI 助手，高亮显示
const AGENT_CLIENTS: [string, boolean][] = [
  ['Claude Duet', true],
  ['ChatGPT dots', true],
  ['Grok Bot', true],
  ['Meta Muse', true],
  ['Claude Code', false],
  ['Cursor', false],
  ['Claude Desktop', false],
];
const PRIVACY_ICONS: IconName[] = ['lock', 'shield', 'cpu'];
const VIEW_ICONS: IconName[] = ['inbox', 'sparkles', 'mail', 'star', 'clock'];
const ACCOUNT_COLORS = ['#1677ff', '#16a34a', '#ea580c'];

const INSTALL = 'curl -fsSL https://damail.app/install.sh | sh';
const startCode = [
  t.start.comment[0],
  INSTALL,
  '',
  t.start.comment[1],
  'curl -fsSL https://damail.app/install.sh | DAMAIL_PUBLIC_URL=https://mail.example.com sh',
  '',
  t.start.comment[2],
];
const claudeCmd = `claude mcp add --transport http damail \\
  https://mail.example.com/mcp \\
  --header "Authorization: Bearer dm_xxx"`;
const jsonCfg = `{
  "mcpServers": {
    "damail": {
      "type": "http",
      "url": "https://mail.example.com/mcp",
      "headers": { "Authorization": "Bearer dm_xxx" }
    }
  }
}`;
const GITHUB_PATH =
  'M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5z';
---

<!doctype html>
<html lang={t.lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="alternate" hreflang="zh-CN" href={base} />
    <link rel="alternate" hreflang="en" href={`${base}en/`} />
    {/* 和文档页（Starlight）共用 localStorage 里的 starlight-theme：light / dark / 空 = 跟随系统 */}
    <script is:inline>
      (() => {
        let saved = '';
        try {
          saved = localStorage.getItem('starlight-theme') || '';
        } catch {}
        const theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <div class="bg" aria-hidden="true"></div>

    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href={prefix}>
          <span class="brand-logo" set:html={logo} />
          <span>DaMail</span>
        </a>
        <nav class="nav-links">
          <a href="#features">{t.nav.features}</a>
          <a href="#assistant">{t.nav.assistant}</a>
          <a href="#agents">{t.nav.agents}</a>
          <a href="#subscriptions">{t.nav.subs}</a>
          <a href="#start">{t.nav.start}</a>
          <a href={docs()}>{t.nav.docs}</a>
        </nav>
        <div class="nav-actions">
          <a class="nav-btn lang" href={`${base}${t.nav.langHref}`} hreflang={locale === 'zh' ? 'en' : 'zh-CN'}>{t.nav.switchLang}</a>
          <button class="nav-btn icon" type="button" id="theme-toggle" aria-label={t.nav.theme} title={t.nav.theme}>
            <Icon name="sun" size={18} class="i-sun" />
            <Icon name="moon" size={18} class="i-moon" />
          </button>
          <a class="nav-btn gh" href={REPO} aria-label="GitHub" title="GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={GITHUB_PATH}></path></svg>
            <span class="gh-stars" data-stars hidden><Icon name="star" size={13} /><span data-stars-n></span></span>
          </a>
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <span class="pill">{t.hero.badge}</span>
        <h1>{t.hero.title[0]}<br /><span class="grad">{t.hero.title[1]}</span></h1>
        <p class="lead">{t.hero.lead}</p>
        <p class="dame">{t.hero.dame}</p>
        <div class="hero-actions">
          <a class="btn primary" href={docs('quick-start/')}>{t.hero.primary}<Icon name="arrow" size={18} /></a>
          <a class="btn ghost" href={REPO}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={GITHUB_PATH}></path></svg>
            {t.hero.secondary}
            <span class="btn-count" data-stars hidden><Icon name="star" size={13} /><span data-stars-n></span></span>
          </a>
        </div>
        <div class="cmd">
          <span class="cmd-prompt">$</span>
          <code>{INSTALL}</code>
          <button type="button" class="cmd-copy" data-copy={INSTALL} data-copied={t.hero.copied} aria-label={t.hero.copy} title={t.hero.copy}>
            <Icon name="copy" size={16} />
          </button>
        </div>

        {/* 产品界面示意：数据都是虚构的 */}
        <div class="shot" aria-hidden="true">
          <div class="win">
            <div class="win-bar">
              <span></span><span></span><span></span>
              <div class="win-url">mail.example.com</div>
            </div>
            <div class="app">
              <div class="rail">
                <span class="rail-logo" set:html={logo} />
                <Icon name="inbox" size={18} class="on" />
                <Icon name="pen" size={18} />
                <Icon name="chart" size={18} />
                <Icon name="sparkles" size={18} />
                <Icon name="bot" size={18} />
              </div>
              <aside class="side">
                {
                  t.mock.views.map(([name, count], i) => (
                    <div class={`side-item${i === 0 ? ' on' : ''}`}>
                      <Icon name={VIEW_ICONS[i]!} size={15} />
                      <span>{name}</span>
                      {count && <em>{count}</em>}
                    </div>
                  ))
                }
                <div class="side-title">{t.mock.accountsTitle}</div>
                {
                  t.mock.accounts.map((name, i) => (
                    <div class="side-item">
                      <i class="dot" style={`background:${ACCOUNT_COLORS[i]}`} />
                      <span>{name}</span>
                    </div>
                  ))
                }
              </aside>
              <div class="list">
                <div class="search"><Icon name="search" size={14} />{t.mock.search}</div>
                {
                  t.mock.threads.map((m, i) => (
                    <div class={`row${i === 0 ? ' on' : ''}${m.unread ? ' unread' : ''}`}>
                      <div class="row-top">
                        <b>{m.from}</b>
                        <time>{m.time}</time>
                      </div>
                      <div class="row-subject">{m.subject}</div>
                      <div class="row-bottom">
                        <span class="row-snippet">{m.snippet}</span>
                        <span class={`chip ${m.tone}`}>{m.tag}</span>
                      </div>
                    </div>
                  ))
                }
              </div>
              <div class="reader">
                <div class="reader-subject">{t.mock.readerSubject}</div>
                <div class="reader-from">
                  <span class="avatar">{t.mock.threads[0]!.from.slice(0, 1)}</span>
                  {t.mock.readerFrom}
                </div>
                <div class="summary">
                  <div class="summary-title"><Icon name="sparkles" size={14} />{t.mock.summaryTitle}</div>
                  <p>{t.mock.summary}</p>
                  <div class="summary-todo"><Icon name="check" size={13} />{t.mock.todo}</div>
                </div>
                <div class="reader-body">{t.mock.body.map((p) => <p>{p}</p>)}</div>
                <div class="reader-actions">
                  <span><Icon name="reply" size={14} />{t.mock.reply}</span>
                  <span>{t.mock.replyAll}</span>
                  <span>{t.mock.forward}</span>
                </div>
              </div>
            </div>
          </div>
          <div class="float agent">
            <div class="float-title"><Icon name="terminal" size={14} />{t.mock.agentTitle}</div>
            <code><span class="fn">{t.mock.agentCall}</span>(<span class="str">"{t.mock.agentArgs}"</span>)</code>
            <div class="float-ok"><Icon name="check" size={13} />{t.mock.agentResult}</div>
          </div>
          <div class="float draft">
            <div class="float-title"><Icon name="pen" size={14} />{t.mock.draftTitle}</div>
            <span class="chip orange">{t.mock.draftState}</span>
          </div>
        </div>
      </section>

      <section class="providers">
        <p>{t.providersTitle}</p>
        <div class="provider-list">{t.providers.map((p) => <span>{p}</span>)}</div>
      </section>

      <section class="section split assistant" id="assistant">
        {/* 站内助手示意：数据都是虚构的 */}
        <div class="assist-shot" aria-hidden="true">
          <div class="assist">
            <div class="assist-head">
              <span class="assist-logo"><Icon name="sparkles" size={15} /></span>
              <b>{chat.title}</b>
              <span class="assist-model">{chat.model}</span>
            </div>
            <div class="assist-body">
              <div class="assist-q"><p>{chat.question}</p></div>
              <div class="assist-a">
                <span class="assist-avatar"><Icon name="sparkles" size={14} /></span>
                <div class="assist-msg">
                  <div class="assist-thought"><Icon name="clock" size={13} />{chat.thought}</div>
                  <ul class="assist-steps">
                    {
                      chat.steps.map(([fn, args, result]) => (
                        <li>
                          <Icon name="check" size={13} class="ok" />
                          <code>
                            <span class="fn">{fn}</span>
                            <span class="args">{args}</span>
                          </code>
                          <span class="flow-result">{result}</span>
                        </li>
                      ))
                    }
                  </ul>
                  <p>{chat.intro}</p>
                  <div class="assist-bills">
                    {
                      chat.bills.map(([name, amount, due], i) => (
                        <div class="assist-bill">
                          <span class="assist-n">{i + 1}</span>
                          <span class="assist-name">{name}</span>
                          <b>{amount}</b>
                          <time>{due}</time>
                        </div>
                      ))
                    }
                  </div>
                  <p class="assist-outro">{chat.outro}</p>
                  <div class="assist-sources">
                    <span>{chat.cited}</span>
                    {
                      chat.sources.map((name) => (
                        <span class="src">
                          <Icon name="mail" size={12} />
                          {name}
                        </span>
                      ))
                    }
                  </div>
                </div>
              </div>
            </div>
            <div class="assist-suggest">{chat.suggestions.map((name) => <span>{name}</span>)}</div>
            <div class="assist-input">
              <span>{chat.placeholder}</span>
              <span class="assist-send"><Icon name="arrow" size={14} /></span>
            </div>
          </div>
        </div>
        <div>
          <span class="kicker">{t.assistant.kicker}</span>
          <h2>{t.assistant.title}</h2>
          <p class="section-lead">{t.assistant.lead}</p>
          <ul class="points">
            {
              t.assistant.points.map(([title, desc], i) => (
                <li>
                  <span class="point-icon">
                    <Icon name={ASSIST_ICONS[i]!} size={18} />
                  </span>
                  <div>
                    <b>{title}</b>
                    <p>{desc}</p>
                  </div>
                </li>
              ))
            }
          </ul>
          <a class="link" href={docs(t.assistant.ctaPath)}>{t.assistant.cta}<Icon name="arrow" size={16} /></a>
        </div>
      </section>

      <section class="section split" id="agents">
        <div>
          <span class="kicker">{t.agents.kicker}</span>
          <h2>{t.agents.title}</h2>
          <p class="section-lead">{t.agents.lead}</p>
          <ul class="points">
            {
              t.agents.points.map(([title, desc], i) => (
                <li>
                  <span class="point-icon">
                    <Icon name={AGENT_ICONS[i]!} size={18} />
                  </span>
                  <div>
                    <b>{title}</b>
                    <p>{desc}</p>
                  </div>
                </li>
              ))
            }
          </ul>
          <div class="agent-clients">
            <span>{t.agents.clientsTitle}</span>
            <div class="provider-list">
              {AGENT_CLIENTS.map(([name, featured]) => <span class:list={{ featured }}>{name}</span>)}
            </div>
          </div>
          <div class="agent-links">
            <a class="link" href={docs('assistants/')}>{t.agents.cta2}<Icon name="arrow" size={16} /></a>
            <a class="link" href={docs('mcp/')}>{t.agents.cta}<Icon name="arrow" size={16} /></a>
          </div>
        </div>
        <div class="agent-col">
        <div class="flow">
          <div class="flow-you">
            <span class="flow-avatar">{t.agents.flow.you.slice(0, 1)}</span>
            <p>{t.agents.flow.prompt}</p>
          </div>
          <ul class="flow-steps">
            {
              t.agents.flow.steps.map(([fn, args, result]) => (
                <li>
                  <Icon name="check" size={14} class="ok" />
                  <code>
                    <span class="fn">{fn}</span>
                    <span class="args">{args}</span>
                  </code>
                  <span class="flow-result">{result}</span>
                </li>
              ))
            }
            <li class="blocked">
              <Icon name="lock" size={14} />
              <code><span class="fn">{t.agents.flow.blocked[0]}</span></code>
              <span class="flow-result">{t.agents.flow.blocked[1]}</span>
            </li>
          </ul>
        </div>
        <div class="code-card" data-tabs>
          <div class="tabs" role="tablist">
            {t.agents.tabs.map((name, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i}>{name}</button>)}
          </div>
          <pre data-panel="0"><code>{claudeCmd}</code></pre>
          <pre data-panel="1" hidden><code>{jsonCfg}</code></pre>
          <div data-panel="2" class="code-note" hidden>{t.agents.chatgpt}</div>
          <div class="scopes">
            {
              ['read', 'organize', 'draft', 'send', 'automation'].map((s, i) => (
                <span class={i < 3 ? 'on' : ''}>
                  {i < 3 && <Icon name="check" size={12} />}
                  {s}
                </span>
              ))
            }
          </div>
        </div>
        </div>
      </section>

      <section class="section" id="features">
        <div class="section-head">
          <span class="kicker">{t.featuresKicker}</span>
          <h2>{t.featuresTitle}</h2>
        </div>
        <div class="grid">
          {
            t.features.map(([title, desc], i) => (
              <div class="card">
                <span class="card-icon">
                  <Icon name={FEATURE_ICONS[i]!} size={20} />
                </span>
                <h3>{title}</h3>
                <p>{desc}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="section split subs-section" id="subscriptions">
        <div>
          <span class="kicker">{t.subs.kicker}</span>
          <h2>{t.subs.title}</h2>
          <p class="section-lead">{t.subs.lead}</p>
          <ul class="points">
            {
              t.subs.points.map(([title, desc], i) => (
                <li>
                  <span class="point-icon">
                    <Icon name={SUBS_ICONS[i]!} size={18} />
                  </span>
                  <div>
                    <b>{title}</b>
                    <p>{desc}</p>
                  </div>
                </li>
              ))
            }
          </ul>
          <a class="link" href={docs('subscriptions/')}>{t.subs.cta}<Icon name="arrow" size={16} /></a>
        </div>
        {/* 订阅管理示意：数据都是虚构的 */}
        <div class="subs-shot" aria-hidden="true">
          <div class="subs">
            <div class="subs-head">
              <b>{subs.title}</b>
              <div class="subs-filters">
                {
                  subs.filters.map(([name, n], i) => (
                    <span class={i === 1 ? 'on' : ''}>
                      {name} <em>{n}</em>
                    </span>
                  ))
                }
              </div>
              <span class="subs-range">{subs.range}</span>
            </div>
            <div class="subs-table">
              <div class="subs-row subs-cols">{subs.cols.map((c) => <span>{c}</span>)}</div>
              {
                subs.rows.map((r) => (
                  <div class={`subs-row${r.state === 'done' ? ' is-done' : ''}`}>
                    <span class="subs-sender">
                      <b>{r.name}</b>
                      <small>{r.address}</small>
                    </span>
                    <span class="subs-count">{r.count}</span>
                    <span class="subs-rate">
                      <i class={r.rate < 20 ? 'low' : ''} style={`--w:${Math.max(r.rate, 2)}%`} />
                      <small>{r.rate === 0 ? subs.never : `${r.rate}%`}</small>
                    </span>
                    <span class={`chip ${r.method === subs.rows[1]!.method ? 'purple' : 'blue'}`}>{r.method}</span>
                    <span class="subs-action">
                      {r.state === 'button' && <span class="subs-btn">{subs.unsubscribe}</span>}
                      {r.state === 'done' && (
                        <span class="subs-done">
                          <Icon name="check" size={13} />
                          {subs.done}
                        </span>
                      )}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>
          <div class="float subs-toast">
            <Icon name="check" size={14} class="ok" />
            {subs.toast}
          </div>
        </div>
      </section>

      <section class="section privacy">
        <div class="section-head">
          <span class="kicker">{t.privacy.kicker}</span>
          <h2>{t.privacy.title}</h2>
        </div>
        <div class="privacy-grid">
          {
            t.privacy.points.map(([title, desc], i) => (
              <div class="privacy-item">
                <Icon name={PRIVACY_ICONS[i]!} size={22} />
                <h3>{title}</h3>
                <p>{desc}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="section split start" id="start">
        <div>
          <span class="kicker">{t.start.kicker}</span>
          <h2>{t.start.title}</h2>
          <ol class="steps">
            {
              t.start.steps.map(([title, desc], i) => (
                <li>
                  <span class="step-n">{i + 1}</span>
                  <div>
                    <b>{title}</b>
                    <p>{desc}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <a class="link" href={docs('quick-start/')}>{t.start.docs}<Icon name="arrow" size={16} /></a>
        </div>
        <div class="code-card terminal">
          <div class="win-bar"><span></span><span></span><span></span></div>
          <pre><code>{startCode.map((line) => (line.startsWith('#') ? <span class="cm">{line}{'\n'}</span> : <span>{line}{'\n'}</span>))}</code></pre>
        </div>
      </section>

      <section class="cta">
        <h2>{t.cta.title}</h2>
        <div class="hero-actions">
          <a class="btn primary" href={docs('quick-start/')}>{t.cta.primary}<Icon name="arrow" size={18} /></a>
          <a class="btn ghost" href={REPO}
            ><Icon name="star" size={18} />{t.cta.secondary}<span class="btn-count" data-stars hidden><span data-stars-n></span></span></a
          >
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <span class="brand-logo" set:html={logo} />
          <div>
            <b>DaMail</b>
            <p>{t.footer.tagline}</p>
          </div>
        </div>
        <nav>
          <a href={docs()}>{t.footer.docs}</a>
          <a href={`${REPO}/releases`}>{t.footer.changelog}</a>
          <a href={`${REPO}/issues`}>{t.footer.issues}</a>
          <a href={`${REPO}/blob/main/LICENSE`}>{t.footer.license}</a>
          <a href={REPO}>GitHub</a>
        </nav>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {}
      });

      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy ?? '');
            btn.classList.add('done');
            btn.title = btn.dataset.copied ?? '';
            setTimeout(() => btn.classList.remove('done'), 1500);
          } catch {}
        });
      });

      // GitHub Star 数：浏览器直接读公开 API（未登录每小时 60 次），本地缓存 1 小时；读不到就只显示图标
      const STARS_KEY = 'damail.site.stars';
      const fmtStars = (n: number) => (n < 1000 ? String(n) : `${(n / 1000).toFixed(n < 10_000 ? 1 : 0).replace(/\.0$/, '')}k`);
      const showStars = (n: number) =>
        document.querySelectorAll<HTMLElement>('[data-stars]').forEach((el) => {
          const label = el.querySelector('[data-stars-n]');
          if (label) label.textContent = fmtStars(n);
          el.title = `${n.toLocaleString()} stars`;
          el.hidden = false;
        });
      let cached: { n?: unknown; t?: unknown } | null = null;
      try {
        cached = JSON.parse(localStorage.getItem(STARS_KEY) ?? 'null');
      } catch {}
      if (typeof cached?.n === 'number') showStars(cached.n);
      if (typeof cached?.t !== 'number' || Date.now() - cached.t > 3600_000) {
        fetch('https://api.github.com/repos/gopkg-dev/damail', { headers: { Accept: 'application/vnd.github+json' } })
          .then((r) => (r.ok ? r.json() : null))
          .then((repo) => {
            const n = repo?.stargazers_count;
            if (typeof n !== 'number') return;
            showStars(n);
            try {
              localStorage.setItem(STARS_KEY, JSON.stringify({ n, t: Date.now() }));
            } catch {}
          })
          .catch(() => {});
      }

      document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((box) => {
        const tabs = box.querySelectorAll<HTMLButtonElement>('[data-tab]');
        tabs.forEach((tab) =>
          tab.addEventListener('click', () => {
            tabs.forEach((x) => x.setAttribute('aria-selected', String(x === tab)));
            box.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== tab.dataset.tab));
          }),
        );
      });
    </script>
  </body>
</html>
